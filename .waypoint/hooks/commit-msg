#!/bin/sh
# Checks commit message type and reminds about recording lessons.

cd "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null || exit 0

# The project's own commit-msg hook from before Waypoint (if any) runs first.
if git config --get waypoint.oncekiHooks >/dev/null 2>&1; then
  sh .waypoint/hooks/onceki-hook commit-msg "$1" || exit 1
fi

# 'python' first: on Windows 'python3' is often only the Microsoft Store stub, and trying it costs a slow process start.
# Each candidate must report Python 3 ('python' may be Python 2 on old systems).
PYTHON=""
if [ "${WAYPOINT_NO_PYTHON:-}" != "1" ]; then
  for candidate in python python3 "py -3"; do
    command -v "${candidate%% *}" >/dev/null 2>&1 || continue
    # shellcheck disable=SC2086  # "py -3" must split into command and argument
    case "$($candidate --version 2>&1)" in "Python 3"*) PYTHON=$candidate; break ;; esac
  done
fi

if [ -z "$PYTHON" ]; then
  printf '%s\n' "❌ Python 3 bulunamadı; Waypoint kuralları denetlenemediği için kayıt engellendi." "   Python 3'ü kurun: https://www.python.org/downloads/ (Windows'ta kurulumda \"Add python.exe to PATH\" kutusunu işaretleyin), sonra tekrar deneyin." >&2
  exit 1
fi
$PYTHON .waypoint/hooks/kontrol.py --mesaj "$1"
exit $?
